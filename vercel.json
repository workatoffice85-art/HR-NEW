{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/archive",
      "destination": "/api/archive.js"
    },
    {
      "source": "/api/sync",
      "destination": "/api/sync.js"
    },
    {
      "source": "/api/send-scheduled-summary",
      "destination": "/api/exec.js?action=sendScheduledSummary"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/exec.js"
    }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/archive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/send-scheduled-summary",
      "schedule": "0 * * * *"
    }
  ]
}